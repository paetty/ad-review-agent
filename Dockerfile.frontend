FROM node:22-slim AS build
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY app ./app
COPY public ./public
COPY worker ./worker
COPY db ./db
COPY .openai ./.openai
COPY next.config.ts vite.config.ts vitest.config.ts tsconfig.json postcss.config.mjs eslint.config.mjs next-env.d.ts ./
ARG NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
RUN pnpm build

FROM node:22-slim
WORKDIR /app
RUN corepack enable
COPY --from=build /app /app
EXPOSE 3000
CMD ["pnpm", "start", "--host", "0.0.0.0"]
