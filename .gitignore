# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# python / local data
/.venv/
__pycache__/
.pytest_cache/
*.py[cod]
*.db
*.sqlite*

# local runs and generated/personal artifacts
/.tmp/
/tmp/
/output/
/outputs/
/.pnpm-store/
*.log

# vercel
.vercel

/dist/
/.wrangler/
/work/
