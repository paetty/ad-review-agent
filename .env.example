# 后端 Provider 配置。不要把真实密钥写入前端 NEXT_PUBLIC_* 变量。
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_PROVIDER=openai_compatible
# 百炼千问等支持此扩展的模型可设为 false；其他服务保持空值，不发送此参数。
LLM_ENABLE_THINKING=
DEMO_MODE=true
ENABLE_IMAGE_REVIEW=false
# 真实模型批量跑 80 条评测会产生费用，默认关闭。
ALLOW_PROVIDER_EVALUATION=false
EXPERIMENT_SALT=replace-with-a-backend-only-random-salt
FRONTEND_ORIGIN=http://localhost:3000
# 可选；留空时使用项目 data/app.db。Docker Compose 会覆盖为持久化目录。
# DATABASE_URL=sqlite:///./data/app.db

# 前端只需要非敏感 API 地址
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api

